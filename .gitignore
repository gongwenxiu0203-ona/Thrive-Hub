# ===== 依赖 =====
/node_modules
/.pnp
.pnp.js

# ===== Next.js 构建产物 =====
/.next/
/out/
/build
next-env.d.ts

# ===== 环境变量（绝不提交，含数据库密码/密钥）=====
.env
.env.*
!.env.example

# ===== 数据库（本地 SQLite 开发库）=====
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-shm
/prisma/*.db-wal
/prisma/prisma/
/prisma/migrations/dev.db*
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ===== 备份文件 =====
/backups/

# ===== 上传文件（用户上传内容不进版本库）=====
/uploads/*
!/uploads/.gitkeep

# ===== 合同与印章运行时文件（仅保留目录占位文件）=====
/public/contract-templates/*
!/public/contract-templates/.gitkeep
/public/contracts-generated/*
!/public/contracts-generated/.gitkeep
/public/contracts-stamped/*
!/public/contracts-stamped/.gitkeep
/public/contracts-test-output/
/public/seal/*
!/public/seal/.gitkeep

# ===== 日志 =====
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ===== 临时 / 测试文件 =====
*.tmp
*.temp
*.bak
*.orig
/tmp/
/temp/
/_spec/
/_spec_unpacked/
temp.txt

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
*.pem
.vscode/
.idea/

