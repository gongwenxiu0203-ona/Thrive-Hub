# ============================================================
#  环境变量模板 — 复制为 .env.development 或 .env.production
#  !! 真实值绝不提交 Git !!
# ============================================================

# ----- 数据库 -----
# 本项目使用 SQLite。Prisma datasource provider 写死在 prisma/schema.prisma
# 和 prisma/migrations/migration_lock.toml 里都是 "sqlite"。
#
# ❌ 不要把 DATABASE_URL 改成 mysql:// 或 postgres:// —— Prisma 校验会直接
#    拒绝，next build 阶段会反复抛 "the URL must start with the protocol file:"
#    错误。如果未来要换库，必须先改 schema.prisma 的 datasource、跑完整迁移
#    评估，不是改这一行的事。
#
# 路径解析：相对路径以 prisma/schema.prisma 所在目录为基准，所以
# "file:./dev.db" 实际指向 prisma/dev.db。
DATABASE_URL="file:./dev.db"

# ----- NextAuth / JWT 密钥（至少 32 位随机字符串）-----
JWT_SECRET=

# ----- External intake link signing secret (independent, at least 32 random bytes) -----
INTAKE_LINK_SECRET=

# ----- Contract Party A fill-link signing secret (independent, at least 32 random bytes) -----
CONTRACT_FILL_LINK_SECRET=

# ----- 应用基础 URL -----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- 文件上传存储路径（相对于项目根目录）-----
UPLOAD_DIR=./uploads

# ----- 腾讯云 COS（如果改用对象存储，可选）-----
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=

# ----- Anthropic Claude API（合同 AI 提取功能）-----
ANTHROPIC_API_KEY=

# ----- SMTP 邮件发送（密码重置功能）-----
# 不填则仅在服务器日志中输出重置链接（适合开发调试）
# 常用 SMTP 配置：
#   QQ 邮箱:   SMTP_HOST=smtp.qq.com      SMTP_PORT=465 SMTP_SECURE=true
#   163 邮箱:  SMTP_HOST=smtp.163.com     SMTP_PORT=465 SMTP_SECURE=true
#   Gmail:     SMTP_HOST=smtp.gmail.com   SMTP_PORT=587 SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cookie 安全模式（生产环境设为 true，本地开发留空即可）
COOKIE_SECURE=

# ----- ICP / 公安备案号（中国大陆合规，显示于网站底部）-----
# 工信部备案：完整备案号，如 粤ICP备2026066858号
NEXT_PUBLIC_ICP_BEIAN_NO=粤ICP备2026066858号
# 公安网安备案：备案号下来后填写，未办理可留空（留空则不显示）
# 完整文字：如 粤公网安备44030502000001号
NEXT_PUBLIC_MPS_BEIAN_NO=
# 公安备案查询码：去掉"粤公网安备"前缀和"号"后缀的纯数字部分
NEXT_PUBLIC_MPS_BEIAN_CODE=

# ----- 运行环境 -----
NODE_ENV=development
