# ============================================================
#  环境变量模板 — 复制为 .env.development 或 .env.production
#  !! 真实值绝不提交 Git !!
# ============================================================

# ----- 数据库 -----
# 开发（SQLite）: file:./prisma/dev.db
# 生产（MySQL）: mysql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=

# ----- NextAuth / JWT 密钥（至少 32 位随机字符串）-----
JWT_SECRET=

# ----- 应用基础 URL -----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- 文件上传存储路径（相对于项目根目录）-----
UPLOAD_DIR=./uploads

# ----- 腾讯云 COS（如果改用对象存储，可选）-----
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=

# ----- Anthropic Claude API（合同 AI 提取功能）-----
ANTHROPIC_API_KEY=

# ----- 运行环境 -----
NODE_ENV=development
