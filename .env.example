# ============================================================
#  环境变量模板 — 复制为 .env.development 或 .env.production
#  !! 真实值绝不提交 Git !!
# ============================================================

# ----- 数据库 -----
# 开发（SQLite）: file:./dev.db  ← Prisma 相对于 schema.prisma 目录解析，此处等价于 prisma/dev.db
# 生产（MySQL）:  mysql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=

# ----- NextAuth / JWT 密钥（至少 32 位随机字符串）-----
JWT_SECRET=

# ----- 应用基础 URL -----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----- 文件上传存储路径（相对于项目根目录）-----
UPLOAD_DIR=./uploads

# ----- 腾讯云 COS（如果改用对象存储，可选）-----
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=

# ----- Anthropic Claude API（合同 AI 提取功能）-----
ANTHROPIC_API_KEY=

# ----- SMTP 邮件发送（密码重置功能）-----
# 不填则仅在服务器日志中输出重置链接（适合开发调试）
# 常用 SMTP 配置：
#   QQ 邮箱:   SMTP_HOST=smtp.qq.com      SMTP_PORT=465 SMTP_SECURE=true
#   163 邮箱:  SMTP_HOST=smtp.163.com     SMTP_PORT=465 SMTP_SECURE=true
#   Gmail:     SMTP_HOST=smtp.gmail.com   SMTP_PORT=587 SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cookie 安全模式（生产环境设为 true，本地开发留空即可）
COOKIE_SECURE=

# ----- 运行环境 -----
NODE_ENV=development
